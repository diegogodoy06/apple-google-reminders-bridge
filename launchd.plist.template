<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.apple-google-reminders-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__INSTALL_DIR__/run-sync.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/runtime/sync.log</string>
  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/runtime/sync-error.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
